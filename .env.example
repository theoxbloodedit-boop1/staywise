# ==========================================
# STAYWISE — Vercel + Neon Production Config
# ==========================================

# 1. Neon PostgreSQL (Pooled + Direct URLs from Neon Console)
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-project-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-your-project.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Neon Auth (Managed Better Auth — from Neon Console > Auth > Configuration)
VITE_NEON_AUTH_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_BASE_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth
# Optional override (defaults to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json)
# NEON_AUTH_JWKS_URL=https://ep-your-project.neonauth.us-east-2.aws.neon.build/neondb/auth/.well-known/jwks.json

# 3. Field Encryption Key (AES-256-GCM for Smart Lock PINs & Wi-Fi passwords)
# Generate with: openssl rand -hex 32
STAYWISE_DATA_KEY=replace_with_64_hex_chars_generated_via_openssl_rand_hex_32

# 4. Media Upload Storage (Optional — uses Vercel Blob when set, falls back to Neon BYTEA table)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
