    "definition": "CREATE OR REPLACE FUNCTION public.reject_admin_audit_mutation()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\nBEGIN RAISE EXCEPTION 'Administrative audit records are append-only'; END $function$\n|security_definer=false"
  },
