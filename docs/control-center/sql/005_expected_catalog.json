    "definition": "CHECK ((status = ANY (ARRAY['Open'::text, 'In Progress'::text, 'Waiting for Customer'::text, 'Escalated'::text, 'Resolved'::text, 'Closed'::text])))"
  },
  {
    "kind": "constraint",
    "name": "admin_support_tickets.admin_support_tickets_status_not_null",
    "definition": "NOT NULL status"
  },
  {
    "kind": "constraint",
    "name": "admin_support_tickets.admin_support_tickets_subject_check",
    "definition": "CHECK (((length(subject) >= 3) AND (length(subject) <= 200)))"
  },
  {
    "kind": "constraint",
    "name": "admin_support_tickets.admin_support_tickets_subject_not_null",
    "definition": "NOT NULL subject"
  },
  {
    "kind": "constraint",
    "name": "admin_support_tickets.admin_support_tickets_updated_at_not_null",
    "definition": "NOT NULL updated_at"
  },
  {
    "kind": "constraint",
    "name": "admin_support_tickets.admin_support_tickets_version_not_null",
    "definition": "NOT NULL version"
  },
  {
    "kind": "constraint",
    "name": "users.users_account_status_check",
    "definition": "CHECK ((account_status = ANY (ARRAY['Active'::text, 'Suspended'::text])))"
  },
